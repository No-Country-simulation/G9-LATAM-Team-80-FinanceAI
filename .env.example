# Copiar a .env y ajustar. Todos los valores tienen un valor por defecto en docker-compose.yml.

# --- Puertos publicados en el host ---
WEB_PORT=8081
API_PORT=8080
ML_PORT=8001
DB_PORT=3307

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=root_local_2026
DB_USER=financeai_app
DB_PASSWORD=FinanceAI_local_2026!

# --- CORS de la API Java (lista separada por comas, admite comodines: https://*.vercel.app) ---
FRONTEND_ORIGIN=http://localhost:5174,http://localhost:8081,http://127.0.0.1:8081

# --- Widget de chat agentico (Oven) ---
OVEN_HABILITADO=true
OVEN_WIDGET_SRC=https://nemxenkgdsjuucmp.public.blob.vercel-storage.com/widget/oven-chat-widget.iife.js
# Pasarela same-origin (evita el CORS del proveedor). Modo directo:
# OVEN_API_URL=https://oven-dandia-nwlcfzg7s-dandia-source.vercel.app
OVEN_API_URL=/oven-api
# Destino real de la pasarela /oven-api/ de nginx (no cambiar al activar el modo proxy).
OVEN_API_ORIGIN=https://oven-dandia-nwlcfzg7s-dandia-source.vercel.app
OVEN_EMBED_KEY=ovek_8a895c59916adc7cec8182e1e5554294826b
OVEN_TENANT=clinica-dandia
OVEN_AGENT=example-tool-agent
OVEN_THEME=ocean
OVEN_VISUAL_STYLE=ocean
OVEN_POSITION=bottom-right
# Texto del compositor de mensajes (el widget lo trae en ingles).
OVEN_TEXTO_ENTRADA=Escribe un mensaje...
# Oculta el enlace de accion rapida del panel ("Agendar cita").
OVEN_OCULTAR_ACCIONES=true
# Preguntas de arranque con tono financiero en la conversacion vacia.
OVEN_PREGUNTAS_INICIALES=true
# Origenes extra permitidos en connect-src del CSP, separados por espacios.
OVEN_EXTRA_CSP=
