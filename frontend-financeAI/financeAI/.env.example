# URL base de la API Java. Vacio = mismo origen (nginx y el proxy de Vite reenvian /api).
VITE_API_URL=

# --- Widget de chat agentico (Oven) embebido en la pagina de Recomendaciones ---
# En Docker estas mismas claves se pasan como OVEN_* al servicio "web" y se inyectan
# en tiempo de ejecucion; aqui solo aplican al modo desarrollo (npm run dev).
VITE_OVEN_HABILITADO=true
VITE_OVEN_WIDGET_SRC=https://nemxenkgdsjuucmp.public.blob.vercel-storage.com/widget/oven-chat-widget.iife.js
# Pasarela same-origin del dev server de Vite (evita el CORS del proveedor).
VITE_OVEN_API_URL=/oven-api
VITE_OVEN_EMBED_KEY=ovek_8a895c59916adc7cec8182e1e5554294826b
VITE_OVEN_TENANT=clinica-dandia
VITE_OVEN_AGENT=example-tool-agent
VITE_OVEN_THEME=ocean
VITE_OVEN_VISUAL_STYLE=ocean
VITE_OVEN_POSITION=bottom-right
VITE_OVEN_TEXTO_ENTRADA=Escribe un mensaje...
VITE_OVEN_OCULTAR_ACCIONES=true
VITE_OVEN_PREGUNTAS_INICIALES=true
